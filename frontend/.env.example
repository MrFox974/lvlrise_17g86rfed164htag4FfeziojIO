VITE_SERVER_PORT=8080
VITE_SERVER_HOST=localhost
VITE_PROTOCOLE=http

# Stripe (optionnel - uniquement si vous utilisez les paiements)
# Clé publique Stripe (commence par pk_test_ ou pk_live_)
# Vous pouvez la trouver dans votre dashboard Stripe : https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# OAuth (boutons Google / Apple sur Login / Inscription)
# Google : Client ID OAuth 2.0 (identique à GOOGLE_CLIENT_ID du backend)
VITE_GOOGLE_CLIENT_ID=

# Apple : Services ID (Sign in with Apple)
VITE_APPLE_CLIENT_ID=

