VITE_SERVER_PORT=8080
VITE_SERVER_HOST=localhost
VITE_PROTOCOLE=http

# Aucune clé Stripe côté frontend : la page Plan appelle le backend, qui crée
# la session de paiement et renvoie l'URL de checkout vers laquelle rediriger.

# OAuth (boutons Google / Apple sur Login / Inscription)
# Google : Client ID OAuth 2.0 (identique à GOOGLE_CLIENT_ID du backend)
VITE_GOOGLE_CLIENT_ID=

# Apple : Services ID (Sign in with Apple)
VITE_APPLE_CLIENT_ID=

