DATABASE_NAME=starter_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

PORT=8080
HOST=localhost

# Origine(s) autorisée(s) pour CORS. Plusieurs origines : séparer par des virgules (ex. https://lvlrise.com,https://www.lvlrise.com)
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=
JWT_REFRESH_SECRET=

# Stripe (si tu actives les paiements)
# Ne mets JAMAIS ta vraie clé ici, uniquement dans backend/.env (local)
STRIPE_SECRET_KEY=

# OpenAI (onboarding IA, génération de flashcards, recherche web)
OPENAI_API_KEY=

# Flashcards — recherche web pour les contenus récents.
# La récolte de faits datés passe par l'outil de recherche du fournisseur ; aucune
# requête ne part du serveur lui-même. Laisser vide convient : les valeurs par
# défaut sont celles ci-dessous.
#   FLASHCARD_WEB_SEARCH=off   coupe la fonctionnalité (la demande est refusée et
#                              l'interface le signale à la fin de la génération)
#   WEB_SEARCH_MODEL           modèle chargé de la récolte (défaut : gpt-4o)
#   WEB_SEARCH_TOOL            noms d'outil tentés dans l'ordre
#                              (défaut : web_search,web_search_preview)
FLASHCARD_WEB_SEARCH=
WEB_SEARCH_MODEL=
WEB_SEARCH_TOOL=

# Flashcards — contrôle de cohérence entre la question et la réponse.
# Une passe supplémentaire par groupe répare les cartes dont le verso ne répond
# pas au recto. FLASHCARD_COHERENCE_AUDIT=off la désactive (moins d'appels, plus
# de cartes bancales).
FLASHCARD_COHERENCE_AUDIT=

# Web Push (notifications PWA)
# Générer la paire avec : npm run generate-vapid
# La clé privée reste secrète (jamais commitée) ; la publique est servie par
# GET /api/push/public-key. Changer la paire invalide tous les abonnements.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lvlrise.com

# OAuth (connexion Google / Apple)
# Google : créer des identifiants dans https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=639436704703-ob6p9j14usct3tjd25l5hv3tlgehr94t.apps.googleusercontent.com

# Apple : créer un Service ID (Sign in with Apple) dans https://developer.apple.com
APPLE_CLIENT_ID=

# Telegram (notifications inscription / abonnement, visites landing, etc.)
# Copier ces lignes dans .env avec tes valeurs locales.
# En production, définir TELEGRAM_* via les variables d'environnement (GitHub Secrets / console, pas dans le code).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP (vérification d'adresse et bienvenue)
# Utilisé uniquement pour ENVOYER des emails (pas IMAP/POP pour lire)
# Exemples : Gmail (smtp.gmail.com:587), SendGrid, Mailgun, Brevo, etc.
SMTP_HOST=mail.gandi.net
SMTP_PORT=587
SMTP_USER=no-reply@lvlrise.com
SMTP_PASS=!+HipHop97424+!
# Format : "Nom affiché" <email@domain.com> — l'email doit correspondre à SMTP_USER
SMTP_FROM='"LvlRise" <no-reply@lvlrise.com>'
# URL du frontend pour les liens dans les emails (sinon CORS_ORIGIN est utilisé)
FRONTEND_URL=http://localhost:5173

